{
  "manifest_version": 3,
  "name": "Quran Citation Verifier",
  "version": "1.0.0",
  "description": "Detects and verifies Quran citations on web pages",
  "icons": {
    "48": "icons/quran_PNG52.png",
    "128": "icons/quran_PNG52.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/shared/messaging.js",
        "js/panel/model.js",
        "js/panel/actions.js",
        "js/panel/keyboard.js",
        "js/panel/sidebar-surface.js",
        "js/render/fonts.js",
        "js/render/swap.js",
        "js/content.js"
      ],
      "css": ["css/content.css", "css/sidebar.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": "icons/quran_PNG52.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": [
        "js/debug-bridge.js",
        "html/sidebar.html",
        "resources/quran-uthmani_desc-v2.json",
        "resources/me_quran.ttf",
        "resources/fonts/uthmani-hafs.ttf",
        "resources/fonts/indo-pak.ttf",
        "resources/fonts/simplified.ttf",
        "resources/QuranAyas/*.png",
        "resources/QuranAyas2/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
