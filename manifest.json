{
  "manifest_version": 3,
  "name": "QuranGuard (صون القرآن)",
  "version": "1.0.0",
  "description": "QuranGuard (صون القرآن) — verifies Quran citations on web pages and assists authors in inserting correct ayahs while typing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/shared/log.js",
        "js/shared/messaging.js",
        "js/shared/i18n.js",
        "js/panel/model.js",
        "js/panel/actions.js",
        "js/panel/keyboard.js",
        "js/panel/sidebar-surface.js",
        "js/render/fonts.js",
        "js/render/tooltip.js",
        "js/render/decoration.js",
        "js/render/ref-marker.js",
        "js/render/swap.js",
        "js/context-atom.js",
        "js/content.js",
        "js/verifier/normalize.js",
        "js/compose/editable.js",
        "js/compose/detect.js",
        "js/compose/match.js",
        "js/compose/dropdown.js",
        "js/compose/insert.js",
        "js/compose/render-editable.js",
        "js/compose/index.js"
      ],
      "css": ["css/content.css", "css/sidebar.css", "css/compose.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": [
        "js/debug-bridge.js",
        "html/sidebar.html",
        "resources/quran-uthmani_desc-v2.json",
        "resources/me_quran.ttf",
        "resources/fonts/uthmani-hafs.ttf",
        "resources/fonts/*.ttf",
        "resources/fonts/*.otf",
        "resources/fonts/*.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
